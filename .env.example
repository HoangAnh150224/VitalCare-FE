# Base URL of the REST API. Defaults to the local Spring Boot backend when unset
# (see src/providers/constants.ts).
VITE_API_URL=http://localhost:8080/api

# Firebase Phone Auth (optional). Used only when the API answers a code request
# with channel "firebase" (APP_FIREBASE_PROJECT_ID set on the backend).
# Public web-app config from Firebase console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
